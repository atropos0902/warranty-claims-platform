server {
  listen 8080;
  root /usr/share/nginx/html;
  resolver ${NGINX_LOCAL_RESOLVERS} ipv6=off valid=10s;

  location = /healthz { return 200 "ok"; }
  location /api/v1/pricing/   { set $up ${PRICING_URL};   proxy_pass $up; }
  location /api/v1/assistant/ { set $up ${ASSISTANT_URL}; proxy_pass $up; }
  location /api/v1/moves      { set $up ${MIGRATION_URL}; proxy_pass $up; }
  location /api/              { set $up ${CLAIMS_URL};    proxy_pass $up; }
  location /dev/token         { set $up ${CLAIMS_URL};    proxy_pass $up; }
  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
